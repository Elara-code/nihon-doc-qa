# 大模型 API（默认使用 Deepseek，OpenAI 兼容）
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Embedding 模型（HuggingFace 模型 id）
EMBEDDING_MODEL=BAAI/bge-m3

# Chroma 持久化目录
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=nihon_doc_qa

# 切块参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 检索参数
TOP_K=5

# 检索模式：vector（仅向量）/ hybrid（向量+BM25 RRF 融合）/ rerank（hybrid 后再精排）
RETRIEVAL_MODE=rerank
# 融合/精排前每路召回的候选数
CANDIDATE_K=20
# RRF 融合常数
RRF_K=60
# 重排序模型
RERANK_MODEL=BAAI/bge-reranker-v2-m3
